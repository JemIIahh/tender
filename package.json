{
  "name": "tender",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p . && NEXT_TELEMETRY_DISABLED=1 pnpm --filter @tender/web exec next typegen && pnpm -r exec tsc --noEmit",
    "lint": "biome check .",
    "skeleton": "tsx scripts/skeleton.ts",
    "demo:local": "tsx scripts/demo-local.ts",
    "seed": "tsx scripts/seed.ts",
    "agent:init": "tsx scripts/agent.ts init",
    "agent:register": "tsx scripts/agent.ts register",
    "agent:retire": "tsx scripts/agent.ts retire",
    "agent:claim-bond": "tsx scripts/agent.ts claim-bond",
    "agent:delegate": "tsx scripts/agent.ts delegate",
    "agent:undelegate": "tsx scripts/agent.ts undelegate",
    "agent:connect": "tsx scripts/agent.ts connect",
    "serve": "tsx scripts/serve.ts",
    "deploy:testnet": "tsx scripts/deploy.ts --network testnet",
    "deploy:mainnet": "tsx scripts/deploy.ts --network mainnet"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@tender/agents": "workspace:*",
    "@tender/api": "workspace:*",
    "@tender/client": "workspace:*",
    "@tender/db": "workspace:*",
    "@tender/indexer": "workspace:*",
    "@tender/judge": "workspace:*",
    "@tender/mcp": "workspace:*",
    "@tender/shared": "workspace:*",
    "@tender/telegram": "workspace:*",
    "@types/node": "24.19.2",
    "near-api-js": "7.4.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
