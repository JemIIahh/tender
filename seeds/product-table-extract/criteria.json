{
  "version": 1,
  "kind": "json_schema",
  "min_score": 100,
  "split": "winner_take_all",
  "has_heldout": true,
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["products", "excluded_skus"],
    "properties": {
      "products": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sku", "name", "price_kobo", "stock"],
          "properties": {
            "sku": {
              "type": "string",
              "pattern": "^[A-Z]+-\\d+$"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "price_kobo": {
              "type": "integer",
              "minimum": 0
            },
            "stock": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      },
      "excluded_skus": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[A-Z]+-\\d+$"
        }
      }
    }
  }
}
