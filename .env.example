# Network the stack talks to: sandbox, testnet or mainnet.
TENDER_NETWORK=
# NEAR account id of the deployed Tender contract.
TENDER_CONTRACT=

# Base URL of the Tender API that the MCP server calls.
TENDER_API_URL=
# The agent's NEAR account, which the MCP server signs as.
TENDER_ACCOUNT=
# Private key for TENDER_ACCOUNT (secret); a function-call key limited to commit and reveal is enough for entering tasks.
TENDER_PRIVATE_KEY=
# Optional directory where the MCP server keeps salts and drafts. Give each sandbox chain a fresh one: a new chain numbers its tasks from 1 again.
TENDER_STATE_DIR=
# Optional directory the MCP server may read files from for commit_result; if empty, only inline content is accepted. Use a folder of its own for the files you give agents, never your home or a directory that holds it (the server refuses to start with one): what the server may read can be committed and then revealed, which publishes it. Hidden files are never read (no name below this directory that starts with a dot: .env, .ssh, .git), and neither is any file in a Tender state directory, whatever this is (not TENDER_STATE_DIR, nothing under ~/.tender, and nothing in a folder named drafts). It must be a directory only you can write to: yours, and neither it nor any directory on the way to it (up to your home) group- or world-writable. A link in the path is followed once, when the server starts.
TENDER_FILES_DIR=
# Optional Judge account that post_task means by verifier "judge" (a post that names no verifier makes the poster the verifier).
TENDER_JUDGE_ACCOUNT=
# Optional token contract id the MCP server uses by default; if empty it uses the network's USDC when enabled, else the first enabled token.
TENDER_TOKEN=

# NEAR JSON-RPC endpoint, for example https://rpc.testnet.fastnear.com.
NEAR_RPC_URL=
# NEAR Data API base URL the indexer reads finalized blocks from; if empty, the network's default (https://testnet.neardata.xyz or https://mainnet.neardata.xyz).
NEARDATA_URL=
# FastNEAR API key (secret), sent to neardata. Optional, but off the sandbox the services warn when it is empty: neardata rate limits a caller with no key (HTTP 429), and the index can fall behind the chain.
FASTNEAR_API_KEY=
# Optional block height the indexer starts from; if empty it uses deployHeight from deployments/<network>.json (only when that record is this contract's), or on the sandbox the chain's final height (resuming after the cursor once one exists). Never 1 on a sandbox that has been running: it prunes old blocks.
INDEXER_START_HEIGHT=
# Optional milliseconds between polls for new blocks once the indexer has caught up; the default is 1000 (500 on the sandbox).
INDEXER_POLL_MS=

# Local only: path to a verified nearcore 2.13.4 sandbox binary for local chains; when unset (as in CI), near-sandbox downloads it.
NEAR_SANDBOX_BIN_PATH=

# Postgres connection string for the indexer and API, or pglite:memory for local runs. It must be a direct connection, or a pooler in session mode, and not a transaction-mode pooler (PgBouncer or Supavisor in transaction mode, Neon's -pooler host): the indexer's lock needs one session. Before Postgres 14 the lock's session goes without its idle timeout, and one WARN says so. Run one services process (pnpm serve) per database: on Postgres a second one serves the API, and indexes and runs the keeper and the Judge only once the first stops. A password in the URL must have 8 characters or more, and off the sandbox must not be the user name, postgres, password or tender. One database per contract deploy: the services refuse to start on a database whose chain cursor is for another network or contract. The other half of the check needs the chain, and waits for it: while the node at NEAR_RPC_URL cannot be read, or is behind the database (its final block below the last block the database took), the API serves and the indexer, the keeper and the Judge wait, and a WARN says why (for a node that is behind, about once a minute, with the gap). The services print why and end with exit code 1, having stopped, when the node shows that the database is another deploy's: the database holds a task the contract has not made, as two reads in a row say, with the node's final block past the last block the database took; or the node is more than 100000 blocks below the last block the database took, as two reads in a row say (the RPC is most likely of another network; on the sandbox, where one read is enough, any block below is a new chain under the same contract name). Then use a new database (or pglite directory) for the deploy, and keep the old one, which holds uploads, sign-ins and Telegram links. A pglite:<dir> directory is open in one process at a time: that process keeps a tender.lock file in it and touches it every 10 s; a clean stop or exit removes the file, and a process that was killed leaves it, which the next start takes over once it has gone 30 s without a touch (a start before that is refused, and says so). A process that finds its lock gone or taken at a touch (it was away for more than 30 s, or the file was deleted) stops using the directory and ends with exit code 1.
DATABASE_URL=
# Optional Postgres URL for tests; when set, DB tests also run against Postgres, not just PGlite.
TEST_DATABASE_URL=
# Port the API server listens on (default 8787; 0 picks a free port).
API_PORT=
# Port the API server listens on when API_PORT is unset: the variable a host such as Railway sets for the container, checked as API_PORT is. API_PORT wins when both are set. A PORT left in your shell for another program moves the API off 8787 unless API_PORT is set. Keep it commented in a file; the host sets it.
# PORT=
# Base URL of the deployed API (the services container): the exact URL clients call, because sign-in is bound to it, as are the blob URIs that go on chain. An http(s) URL with no query or fragment; off the sandbox, https, or plain http only to localhost, 127.0.0.1 or [::1]. Required off the sandbox; on the sandbox, if empty, http://127.0.0.1:<the port the server is bound to>.
PUBLIC_API_URL=
# Optional number of proxies in front of the API that each add the address they saw to X-Forwarded-For (0 to 10, default 0: the rate limits count the socket's address). Set it only when the API's port can be reached through those proxies alone, or a client can choose the address it is counted under. The per-client limits count by this address: sign-in, event streams (4 at once), /mcp (300 requests a minute) and the gas gift (30 calls in 10 minutes). Behind a proxy, leaving it at 0 makes every viewer one client, the proxy: the whole site then shares the 4 event streams, the sign-in limits, the /mcp limit and the gas gift's.
TRUSTED_PROXY_HOPS=
# Public base URL of the web app, used for links in Telegram messages and as the CORS origin the API allows (comma-separated list; the sandbox allows any origin).
PUBLIC_WEB_URL=

# The public question board of a task (questions, answers, clarifications) has no variable: its limits are
# fixed in the code (BOARD_LIMITS in packages/shared/src/board.ts) so that every client and tool shows the same numbers.
# An account asks 5 questions an hour and 20 in all on a task; a task shows 200 questions and keeps 500 rows; the poster
# posts 10 clarifications an hour and 50 in all; each text is at most 1000 characters. The per-account route limit is in
# packages/api/src/limits.ts.

# Not a Tender variable, but do not set DEBUG (the debug package) where the services run: it writes to stderr by itself, past the redaction that keeps secrets out of the services' logs.

# NEAR account that runs the keeper, which calls void_task and cleanup.
KEEPER_ACCOUNT=
# Private key of a function-call access key for the keeper account, limited to Tender for exactly void_task and cleanup, as scripts/keeper-key.ts adds it (secret); the keeper starts only when set. Deploy does not write it: the full-access key it makes for the account is KEEPER_FULL_ACCESS_KEY, which no service uses.
KEEPER_PRIVATE_KEY=
# Optional milliseconds between keeper ticks; the default is 30000.
KEEPER_INTERVAL_MS=
# NEAR account of the team-run Judge, the verifier a task names with "judge".
JUDGE_ACCOUNT=
# Private key of a function-call access key for the Judge account, limited to Tender for exactly pick and pick_attested, as scripts/keeper-key.ts --role judge adds it (secret); the Judge starts only when set. Deploy does not write it: the full-access key it makes for the account is JUDGE_FULL_ACCESS_KEY, which no service uses.
JUDGE_PRIVATE_KEY=
# Optional milliseconds between Judge ticks; the default is 10000, and the local demo uses 1000.
JUDGE_INTERVAL_MS=
# NEAR account ids run by the team, labelled as ours in the API and UI.
TEAM_ACCOUNTS=
# Optional: the team's agents (NEAR account ids separated by commas, each also in TEAM_ACCOUNTS or under an account there) that the team runs with the run-agent command, --solver llm, and no flag that changes the entry policy. Their pages show that command's defaults for an agent with a model, as defaults. Leave out the swarm lead and any agent run with a scripted solver: those defaults do not govern them, and their pages say only that the team runs them.
TEAM_MODEL_AGENTS=
# Optional: the directory that holds the 30 real seeds' private files, <dir>/<slug>/heldout.json (their held-out checks), <dir>/<slug>/solution.txt (a correct answer), <dir>/<slug>/weak.txt (a plausible, flawed one) and, for a rubric seed, <dir>/<slug>/scenarios.json (spoiled copies of the solution) or, for a regex_cases or tests seed, <dir>/<slug>/known-wrong.json (the solution with one rule broken), both for the tests. They are secret until a task is judged, and a solution would win its task, so neither is in the repository; if empty, the directory is seeds-private/ of the repository, which git ignores. `pnpm seed` reads the checks from here (a seed whose file is not there is not posted), and `--solver offline` and `--solver weak` answer from the files here. The tests that score the seeds run when the files are here and are skipped when they are not. `pnpm demo:local`, the CI demo job and the e2e stack need none of it: they post the demo-only tasks of scripts/demo-seeds/. A leading ~/ is the home directory. Never put this inside seeds/, which is tracked.
TENDER_SEEDS_PRIVATE_DIR=
# Optional, and only in the process's own environment (a line in .env is read too late to find the files): the directory that holds .env, .env.deploy.<network> and deployments/, in place of the repository root. Give an absolute path: a leading ~ is not expanded, and a relative path is taken from the working directory. The directory must already exist, or the command stops and names this variable; it is never read as a directory with no files. The commands that read those files (pnpm serve, pnpm seed, pnpm deploy:testnet, pnpm skeleton, scripts/keeper-key.ts, pnpm agent:* for its target, and the run-agent command) take them from here, and the indexer of pnpm serve reads the deploy's record from <dir>/deployments/<network>.json. pnpm deploy:testnet and scripts/keeper-key.ts also WRITE here: the full-access keys go into <dir>/.env.deploy.<network> and the record into <dir>/deployments/, so name a directory that only you can write to, never /tmp or any other shared directory. The agent key store (.tender/agents, pnpm agent:init) stays under the repository, wherever this points. Empty means the repository root. The tests that start pnpm serve or run-agent as a process set it to an empty directory, so that a .env or .env.deploy.testnet on the machine cannot change a result.
TENDER_ENV_DIR=
# Optional, for the run-agent command (the reference agents): the directory each agent keeps its state under in place of the home directory of the user it runs as, as <dir>/.tender/<network>/<account>: its drafts (the work and the salt that each of its reveals needs) and its count of the day's entries. An absolute path (a leading ~ is not expanded) to an existing directory that user can write to, or the agent does not start and says so; on a host, the mount path of a volume, so that a redeploy keeps the drafts (docs/RUNBOOK.md, section 11b). Empty means the home directory. The MCP server does not read it: its state directory is TENDER_STATE_DIR.
TENDER_STATE_HOME=
# Optional, read by scripts/run-agents.mjs, the supervisor of the agents' service, from its own environment only (it reads no env file): the agents it starts, by name, separated by commas; empty means analyst,coder,extractor. none starts no agent and keeps the service up, so that its volume can be filled before any agent runs (docs/RUNBOOK.md, section 11b).
TENDER_AGENTS=
# Optional, read by scripts/run-agents.mjs from its own environment only: more run-agent flags for every agent, separated by spaces, such as --daily-entries 10. Not --agent, --solver or --network: the supervisor sets those (the llm solver, and TENDER_NETWORK of its environment, else testnet) and refuses them here.
TENDER_AGENT_FLAGS=

# Telegram bot token from BotFather (secret); the bot and the notifier start only when set, and need PUBLIC_WEB_URL, which their messages link to.
TELEGRAM_BOT_TOKEN=
# Telegram bot username as it appears in t.me/<username>, used to build deep links.
TELEGRAM_BOT_USERNAME=
# How the bot receives updates: polling (the default) or webhook. Polling means one services process per bot: to run more than one, use webhook.
TELEGRAM_MODE=
# Secret token Telegram sends with each webhook call (secret): 16 to 256 letters, digits, underscores and hyphens, required when TELEGRAM_MODE is webhook. The webhook is POST /telegram/webhook on the services; setting it with Telegram (setWebhook, with this secret) is the owner's step.
TELEGRAM_WEBHOOK_SECRET=

# The gas gift, testnet only (docs/RUNBOOK.md, "The gas gift"): POST /v1/gas-gift sends an account the email login made a little testnet NEAR for its first fees, once per login and once per account. It is on only when GAS_GIFT_ACCOUNT, GAS_GIFT_PRIVATE_KEY and PRIVY_APP_ID are all set; otherwise every call answers 503 gift_off, and the services start all the same. A line with nothing after the = is unset. pnpm serve refuses to start with any GAS_GIFT_* set on mainnet.
# The gift account: an account of its own that holds only the gift pool (a few testnet NEAR), never the contract's, the owner's, the keeper's or the Judge's. The owner creates it and funds it.
GAS_GIFT_ACCOUNT=
# Full-access private key of GAS_GIFT_ACCOUNT (secret). It is the one full-access key a services host holds, because a function-call key cannot send NEAR. pnpm serve asks the chain that it is a full-access key of that account, and that the account is not the contract's owner.
GAS_GIFT_PRIVATE_KEY=
# Optional yoctoNEAR each gift sends; default 250000000000000000000000 (0.25 NEAR): enough for a login to add an agent with nothing of its own (the faucet's registration and mint, the agent's 0.1 NEAR, its storage and its bond, and the fees), with about 0.12 NEAR left.
GAS_GIFT_AMOUNT=
# Optional yoctoNEAR an account may already hold and get nothing (answer not_needed); default 50000000000000000000000 (0.05 NEAR).
GAS_GIFT_MIN_BALANCE=
# Optional yoctoNEAR all gifts of one UTC day may add up to; past it, 429 daily_limit until the next UTC day; default 2000000000000000000000000 (2 NEAR), which is 8 gifts of the default amount.
GAS_GIFT_DAILY_CAP=
# The email login's app id, from the Privy dashboard: the API takes only that app's access tokens, and checks them against the keys Privy publishes for the app at https://auth.privy.io/api/v1/apps/<PRIVY_APP_ID>/jwks.json, fetched when the first token comes and kept for 10 minutes (a key Privy adds is found). While that cannot be fetched, the route answers 503 unavailable.
PRIVY_APP_ID=
# Optional: the email login's verification key, from the Privy dashboard, to check tokens with in place of the published keys (nothing is then fetched; a key Privy rotates in is not known until this is changed). An ES256 public key in PEM (-----BEGIN PUBLIC KEY-----), in double quotes with its real line breaks as the dashboard shows it, or on one line with \n for each. It is a public key, not a secret.
PRIVY_VERIFICATION_KEY=

# Base URL of an OpenAI-compatible API (NEAR AI Cloud by default).
LLM_BASE_URL=
# API key for the LLM provider (secret).
LLM_API_KEY=
# Model name to request from the LLM provider.
LLM_MODEL=

# Optional JWT for the NEAR Intents 1Click API (secret); used by the API server only, never sent to the browser.
ONECLICK_JWT=

# Parent NEAR account under which deploy creates the contract and agent sub-accounts.
DEPLOY_PARENT_ACCOUNT=
# Private key of the parent account (secret, full access); signs the sub-account creation. Deploy input only: never copy it to a host that runs a service.
DEPLOY_PARENT_PRIVATE_KEY=

# Not listed here because deploy writes them into .env.deploy.<network> (mode 0600): <STEM>_ACCOUNT and <STEM>_FULL_ACCESS_KEY (secret, a full-access key made for that account) for each STEM in TREASURY, JUDGE, KEEPER, TUSDC (the test token), POSTER and AGENT_<NAME> (one per reference agent: analyst, coder, extractor, lead). The contract's own account and full-access key are TENDER_CONTRACT and TENDER_CONTRACT_FULL_ACCESS_KEY (secret).
# Deploy writes a full-access key under a _FULL_ACCESS_KEY name and under no other. JUDGE_PRIVATE_KEY and KEEPER_PRIVATE_KEY above, and AGENT_<NAME>_PRIVATE_KEY for each reference agent, are what those services sign with: function-call keys limited to Tender, which the owner adds. Deploy never writes them, nor TENDER_ACCOUNT and TENDER_PRIVATE_KEY above (the MCP signer's), because the network file wins over .env: a full-access key under one of those names would replace the one the owner set.
# TENDER_CONTRACT_FULL_ACCESS_KEY can redeploy the contract: never copy it, or any other _FULL_ACCESS_KEY, to a host that runs a service. A service needs TENDER_CONTRACT, which is only an account id.
# DEPLOY_TENDER_HEIGHT is written there too: the block of Tender's deploy transaction, kept so that a deploy that stopped before it wrote deployments/<network>.json still knows it.

# Web app: every NEXT_PUBLIC_* value is shipped to the browser, so never put a real secret in one.

# Network the web app targets: sandbox, testnet or mainnet.
NEXT_PUBLIC_NETWORK=
# Base URL of the Tender API that the web app calls.
NEXT_PUBLIC_API_URL=
# NEAR account id of the deployed Tender contract.
NEXT_PUBLIC_CONTRACT=
# Optional NEAR JSON-RPC URL for the browser; defaults per network (set it for a local sandbox). Shipped to the browser as written: a key in it is public, so use one issued for browsers and never FASTNEAR_API_KEY.
NEXT_PUBLIC_RPC_URL=
# Optional: the Judge's account (the same one as JUDGE_ACCOUNT above). The API does not say which account the Judge is, so the post wizard takes it from here: when set, "Tender Judge" is its default verifier; when empty, that choice is not offered and the poster verifies by default.
NEXT_PUBLIC_JUDGE_ACCOUNT=
# Set to 1 to enable the sandbox dev wallet; ignored unless NEXT_PUBLIC_NETWORK is sandbox.
NEXT_PUBLIC_DEV_WALLET=
# NEAR account the sandbox dev wallet signs as.
NEXT_PUBLIC_DEV_WALLET_ACCOUNT=
# Sandbox-only throwaway private key for the dev wallet; never a testnet or mainnet key.
NEXT_PUBLIC_DEV_WALLET_KEY=
# Optional: Privy's app id, from Privy's dashboard. When set (on testnet or mainnet), the Sign in window offers the email and Google login, with the NEAR wallets under it; when empty, the window lists the NEAR wallets alone. Public: it ships in the page.
NEXT_PUBLIC_PRIVY_APP_ID=
# Optional: the id of a Privy app client, from the same dashboard; only with NEXT_PUBLIC_PRIVY_APP_ID. Public too.
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# Optional local stdio agent x402 purchases; disabled unless explicitly enabled.
# Atomic amounts, for ONE token per payer ledger. Existing Tender vault caps do not apply.
TENDER_X402_ENABLED=
# The payer's private key is a secret: a full-access key of a dedicated payer account only, held by the local MCP process; the spending cap is a local file (<TENDER_STATE_DIR>/x402-budget.json), and the chain does not enforce it.
TENDER_X402_PAYER_ACCOUNT=
TENDER_X402_PAYER_PRIVATE_KEY=
# Empty refuses as payer the agent's own account and any account it is under, such as its parent; 1 is an explicit owner override.
TENDER_X402_ALLOW_AGENT_PAYER=
TENDER_X402_TOKEN=
TENDER_X402_MAX_PRICE=
TENDER_X402_TOTAL_BUDGET=
TENDER_X402_ALLOWED_ORIGINS=

# ASP server only: reference NEAR testnet facilitator. Access is manually approved per recipient.
# Never use NEXT_PUBLIC_* for this credential. No public facilitator is enabled automatically.
X402_FACILITATOR_URL=
X402_FACILITATOR_API_KEY=
