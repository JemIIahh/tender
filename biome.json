{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**", "!**/node_modules", "!contract", "!docs", "!.superpowers", "!pnpm-lock.yaml"]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["apps/web/**", "!apps/web/e2e/**", "!apps/web/test/**", "!apps/web/*.config.*"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@tender/client": "The web app imports only `@tender/client/outcome` (P06-P3): the root also exports Node-only modules that must not reach the browser bundle."
                }
              }
            }
          }
        }
      }
    }
  ]
}
